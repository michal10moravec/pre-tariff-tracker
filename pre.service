[Unit]
Description=PRE low-tariff schedule
After=network-online.target

[Service]
Type=simple
# Adjust these two paths for the actual account and Node installation.
WorkingDirectory=%h/pre-scraper
ExecStart=/usr/bin/node build/index.js
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=15
TimeoutStopSec=550
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pre-scraper

[Install]
WantedBy=default.target
