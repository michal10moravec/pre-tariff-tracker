# Varianta A: přihlášení do Moje PRE. Heslo s # nebo mezerami uzavřete do uvozovek.
PRE_USERNAME=
PRE_PASSWORD=

# Varianta B: třímístný povel pro nízký tarif z Moje PRE / přijímače HDO.
# Pokud je vyplněn, má přednost; přihlášení ani Chromium nejsou potřeba.
HDO_CODE=

SERVER_HOST=127.0.0.1
SERVER_PORT=3000
REFRESH_MINUTES=60
RETRY_MINUTES=5
REQUEST_TIMEOUT_SECONDS=45
CACHE_FILE=data/schedules.json
BROWSER_HEADLESS=true
# Na Raspberry Pi typicky /usr/bin/chromium
BROWSER_EXECUTABLE_PATH=
